# Supabase project settings — dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, never expose to the client. Used in
# lib/supabase/server.ts's createAdminClient() for operations that must
# bypass RLS (audit log writes, onboarding org bootstrap).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
